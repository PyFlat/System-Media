<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <IsPackable>false</IsPackable>
        <IsTestProject>true</IsTestProject>
        <!-- Underscored test names. -->
        <NoWarn>$(NoWarn);CA1707</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="MacroDeck.Plugin.Testing" />
        <PackageReference Include="Microsoft.NET.Test.Sdk" />
        <PackageReference Include="NUnit" />
        <PackageReference Include="NUnit.Analyzers" PrivateAssets="all" />
        <PackageReference Include="NUnit3TestAdapter" />
    </ItemGroup>

    <ItemGroup Condition="'$(SystemMediaWindows)' != 'true'">
        <Compile Remove="Windows\**" />
    </ItemGroup>

    <ItemGroup Condition="'$(SystemMediaWindows)' == 'true'">
        <Compile Remove="Linux\**" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\src\SystemMedia\SystemMedia.csproj" />
    </ItemGroup>

</Project>
