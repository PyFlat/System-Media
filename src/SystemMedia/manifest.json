{
  "$schema": "https://schemas.macro-deck.app/plugin-manifest-v1.schema.json",
  "manifestVersion": 1,
  "id": "com.pyflat.system-media",
  "name": "System Media",
  "version": "1.0.0",
  "description": "Drives the built-in Music Player widget from whatever app is playing media on Windows, macOS or Linux (Spotify, browsers, Apple Music and any app in the system's media controls or MPRIS, plus SMPlayer and mpv), with per-app volume on Windows and Linux.",
  "icon": "Assets/icon.svg",
  "entrypoints": {
    "win-x64": {
      "executable": "runtimes/win-x64/SystemMedia.dll",
      "runtime": {
        "kind": "FrameworkDependent",
        "dotnetVersion": "10.0"
      }
    },
    "osx-arm64": {
      "executable": "runtimes/osx-arm64/SystemMedia.dll",
      "runtime": {
        "kind": "FrameworkDependent",
        "dotnetVersion": "10.0"
      }
    },
    "linux-x64": {
      "executable": "runtimes/linux-x64/SystemMedia.dll",
      "runtime": {
        "kind": "FrameworkDependent",
        "dotnetVersion": "10.0"
      }
    }
  },
  "publisher": {
    "name": "PyFlat"
  },
  "license": "MIT",
  "permissions": [
    "events:publish",
    "assets:upload",
    "process:spawn",
    "fs:user-files",
    "net:outbound"
  ],
  "ai": {
    "interaction": false,
    "generatedContent": false,
    "generatedAssets": false
  },
  "compatibility": {
    "macroDeck": ">=3.0.0-beta.15"
  },
  "repository": "https://github.com/PyFlat/System-Media"
}